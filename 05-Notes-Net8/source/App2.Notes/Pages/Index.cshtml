@page
@model IndexModel
@{
    ViewData["Title"] = "Notes";
}

<div class="p-4 mb-4 rounded-3" style="background:#fff4e6;border:1px solid #ffd8a8">
    <h1 class="display-6" style="color:#d9480f">&#128221; App2 &mdash; Notes</h1>
    <p class="mb-0 text-muted">ASP.NET Core Razor Pages on <b>@Model.Machine</b> &middot; @Model.Framework</p>
</div>

<form method="post" asp-page-handler="Add" class="d-flex gap-2 mb-1">
    <input asp-for="NewNote" class="form-control" placeholder="Write a note..." autocomplete="off" />
    <button type="submit" class="btn btn-warning">Add</button>
</form>
<span asp-validation-for="NewNote" class="text-danger small"></span>

<ul class="list-group mt-3">
    @foreach (var n in Model.Notes)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
                <div>@n.Text</div>
                <small class="text-muted">#@n.Id &middot; @n.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</small>
            </div>
            <form method="post" asp-page-handler="Delete" asp-route-id="@n.Id">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
        </li>
    }
</ul>

<p class="mt-3 small">JSON: <a href="~/api/notes">api/notes</a></p>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <AssemblyName>App1.ServerInfo</AssemblyName>
    <RootNamespace>App1.ServerInfo</RootNamespace>
    <!-- Runs inside IIS worker process (w3wp.exe), like the other builds -->
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <!-- Run ONLY on .NET Core 3.1.x (never roll forward to 5, 6, 7, 8, 10) -->
    <RollForward>LatestPatch</RollForward>
  </PropertyGroup>

</Project>
